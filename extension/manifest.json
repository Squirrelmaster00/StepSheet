{
  "manifest_version": 3,
  "name": "StepSheet",
  "version": "1.55.0",
  "description": "Edit .soe work instructions and make step-by-step PDFs in English and Spanish. Works offline; files stay on your computer.",
  "action": {
    "default_title": "Open StepSheet",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [],
  "offline_enabled": true
}